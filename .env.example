# Recall — environment variables
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Day 1 scaffold runs with just DATABASE_URL and SESSION_SECRET. The remaining
# variables are required from the day noted in the comment.

# --- Database (Day 1) ---
# SQLite for local dev. Production uses Vercel Postgres.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Site identity (Day 1) ---
# The public origin Recall is served from. Used for cookie scope and the
# WebMCP `fromOrigins` grant set. Set to your Vercel preview URL in preview.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Recall"

# --- Session cookie signing (Day 1) ---
# Random 32+ char string. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-me-with-a-32-plus-char-random-string"

# --- GitHub OAuth (Day 2 — demo-day substitute for ChatGPT OAuth) ---
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Site signing key (Day 6/7 — optional override) ---
# Optional. If unset, Recall generates a per-user ECDSA P-256 key on first
# sign-in via WebCrypto and stores the JWK in the User.siteKeyJwk column.
# Production deployments MAY set a stable base64url JWK here so signatures
# verify across deployments. Do NOT commit a real key.
RECALL_SITE_KEY_JWK=""
