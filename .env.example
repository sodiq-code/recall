# Recall — environment variables
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# All variables below are required for the app to boot (validated by lib/env.ts).

# --- Database (Turso / libSQL) ---
# Runtime: the libSQL client reads TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
# Create a free database at https://turso.tech → copy the libsql URL + auth token.
TURSO_DATABASE_URL="libsql://your-db.your-org.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"

# DATABASE_URL is used by the Prisma CLI for schema validation (must be a file: URL).
# The runtime connection uses TURSO_* above; this is only for tooling.
DATABASE_URL="file:./db/migrations.db"

# DIRECT_DATABASE_URL is used by the Prisma CLI (db push / migrate).
DIRECT_DATABASE_URL="file:./db/migrations.db"

# --- Site identity ---
# The public origin Recall is served from. Used for cookie scope and the
# WebMCP `fromOrigins` grant set. Set to your Vercel preview URL in preview.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Recall"

# --- Session cookie signing ---
# Random 32+ char string. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-me-with-a-32-plus-char-random-string"

# --- GitHub OAuth (demo-day substitute for ChatGPT OAuth) ---
# Create an OAuth app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/oauth/github/callback
# (add the Vercel production URL as a second redirect URI after deploy)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Realtime WebSocket mini-service ---
# Port the socket.io mini-service listens on. The frontend connects via
# io("/?XTransformPort=<port>") so the gateway routes it correctly.
REALTIME_PORT="3003"

# --- Site signing key (optional override — next tasks) ---
# Optional. If unset, Recall generates a per-user ECDSA P-256 key on first
# sign-in via WebCrypto and stores the JWK in the User.siteKeyJwk column.
# Production deployments MAY set a stable base64url JWK here so signatures
# verify across deployments. Do NOT commit a real key.
RECALL_SITE_KEY_JWK=""
